{
  "name": "tagging/tag",
  "type": "library",
  "license": "PolyForm-Noncommercial-1.0.0",
  "description": "Tagging process app",
  "minimum-stability": "dev",
  "prefer-stable": true,
  "require": {
    "symfony/console": "^8.1",
    "symfony/options-resolver": "^8.1",
    "symfony/validator": "^8.1",
    "symfony/form": "^8.1",
    "php": "^8.4",
    "ext-pdo": "*",
    "ext-curl": "*",
    "ext-mbstring": "*",
    "ext-ctype": "*",
    "ext-intl": "*",
    "symfony/config": "^8.1",
    "symfony/dependency-injection": "^8.1",
    "symfony/http-kernel": "^8.1",
    "symfony/routing": "^8.1",
    "symfony/yaml": "^8.1",
    "symfony/framework-bundle": "^8.1",
    "doctrine/doctrine-bundle": "^3.3",
    "doctrine/orm": "^3.7",
    "doctrine/doctrine-migrations-bundle": "^4.0",
    "easycorp/easyadmin-bundle": "^5.6",
    "objecting/object": "dev-master",
    "cruding/crud": "dev-master",
    "collectioning/collection": "dev-master",
    "tabling/table": "dev-master",
    "viewing/view": "dev-master",
    "interfacing/interface": "dev-master",
    "administering/administration": "dev-master"
  },
  "require-dev": {
    "doctrine/doctrine-fixtures-bundle": "^4.3",
    "friendsofphp/php-cs-fixer": "^3.94",
    "symfony/browser-kit": "^8.1",
    "symfony/css-selector": "^8.1",
    "phpmd/phpmd": "3.x-dev",
    "pdepend/pdepend": "3.x-dev",
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^10.5",
    "symfony/panther": "^2.2",
    "gating/gate": "dev-master"
  },
  "autoload": {
    "psr-4": {
      "App\\Tagging\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/",
      "Tests\\Integration\\": "tests/integration/",
      "Tests\\E2E\\": "tests/e2e/",
      "Tests\\Panther\\": "tests/panther/"
    }
  },
  "scripts": {
    "lint": "php tools/tag-lint.php",
    "lint:admin": "node --check admin/tag-admin.js",
    "phpstan": "vendor/bin/phpstan analyse -c phpstan.neon.dist --memory-limit=512M",
    "cs:check": "vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.dist.php --dry-run --diff --using-cache=no",
    "cs:fix": "vendor/bin/php-cs-fixer fix --config=.php-cs-fixer.dist.php --using-cache=no",
    "fixture:validate": "php tools/seed/tag-fixture-validate.php",
    "fixture:dry-run": "php tools/seed/tag-fixture-dry-run.php",
    "docs:openapi:publish": "php tools/release/tag-openapi-publish.php",
    "audit:surface": "php tools/audit/tag-surface-audit.php",
    "audit:contract": "php tools/audit/tag-contract-audit.php",
    "audit:route": "php tools/audit/tag-route-controller-audit.php",
    "audit:bootstrap": "php tools/audit/tag-bootstrap-audit.php",
    "audit:bootstrap-runtime": "php tools/audit/tag-bootstrap-runtime-audit.php",
    "audit:config": "php tools/audit/tag-config-audit.php",
    "audit:sdk": "php tools/audit/tag-sdk-audit.php",
    "audit:version": "php tools/audit/tag-version-audit.php",
    "audit:release-assets": "php tools/audit/tag-release-assets-audit.php",
    "audit:openapi-semantics": "php tools/audit/tag-openapi-semantics-audit.php",
    "audit:generated-openapi-surface": "php tools/audit/tag-generated-openapi-surface-audit.php",
    "audit:antora-surface": "php tools/audit/tag-antora-surface-audit.php",
    "release:preflight": "php tools/release/tag-preflight.php",
    "db:migrate": "php tools/db/tag-migrate.php",
    "schema:validate": "php bin/console doctrine:schema:validate",
    "schema:parity": ["php bin/console doctrine:schema:validate", "php bin/console doctrine:migrations:up-to-date"],
    "db:smoke": "bash tools/db/tag-tag-migration-tag-smoke.sh",
    "db:test:start": "bash tools/tag-tag-test-db-start.sh",
    "db:test:stop": "bash tools/tag-tag-test-db-stop.sh",
    "db:smoke:self-contained": "bash tools/tag-tag-migration-tag-smoke.sh",
    "demo:seed": "php tools/seed/tag-seed.php",
    "demo:clear": "php tools/seed/tag-clear.php",
    "smoke:runtime": "vendor/bin/phpunit tests/TagSymfonyNativeSurfaceTest.php tests/TagSymfonyNativeContainerSurfaceTest.php tests/TagSymfonyNativeLegacyRuntimeRemovalTest.php tests/TagCrudingEntrypointResolutionTest.php",
    "smoke:http": "php tools/smoke/tag-smoke.php",
    "audit:canonical-stale": "php tools/audit/tag-canonical-stale-reference-audit.php",
    "audit:canonical-structure": "php tools/audit/tag-canonical-structure-audit.php",
    "audit:ci": [
      "@docs:openapi:publish",
      "@audit:composer-integrity",
      "@audit:surface",
      "@audit:contract",
      "@audit:route",
      "@audit:bootstrap",
      "@audit:bootstrap-runtime",
      "@audit:config",
      "@audit:sdk",
      "@audit:version",
      "@audit:release-assets",
      "@audit:openapi-semantics",
      "@audit:generated-openapi-surface",
      "@audit:antora-surface",
      "@audit:core-boundary",
      "@audit:canonical-stale",
      "@audit:canonical-structure",
      "@audit:repo-hygiene",
      "@audit:snapshot-purity",
      "@audit:repo-map-truth",
      "@audit:ci-workflow",
      "@audit:demo-truth-pack",
      "@audit:release-grade-portrait",
      "@test:unit"
    ],
    "audit:composer-integrity": "php tools/audit/tag-composer-integrity-audit.php",
    "test": "vendor/bin/phpunit --testsuite unit",
    "test:unit": "vendor/bin/phpunit --testsuite unit",
    "test:cruding": "vendor/bin/phpunit tests/TagCrudingEntrypointResolutionTest.php",
    "test:integration": "vendor/bin/phpunit --testsuite integration",
    "test:panther": [
      "tools/local/tag-panther-test.sh"
    ],
    "test:e2e": "npx playwright test",
    "test:e2e:install": "npx playwright install chromium",
    "doctor:php-ext": "bash tools/local/tag-php-extension-doctor.sh",
    "host:test-db:serve": "bash tools/local/tag-serve-test-db.sh",
    "gate:install-test": [
      "composer validate --no-interaction --strict",
      "@audit:composer-integrity",
      "@test:unit"
    ],
    "audit:repo-hygiene": "php tools/audit/tag-repo-hygiene-audit.php",
    "audit:snapshot-purity": "php tools/audit/tag-snapshot-purity-audit.php",
    "audit:repo-map-truth": "php tools/audit/tag-repo-map-truth-audit.php",
    "audit:ci-workflow": "php tools/audit/tag-ci-workflow-audit.php",
    "test:all": "vendor/bin/phpunit",
    "test:coverage": "vendor/bin/phpunit --testsuite unit --coverage-text=var/coverage/coverage.txt --coverage-filter=src --path-coverage",
    "audit:core-boundary": "php tools/audit/tag-core-boundary-audit.php",
    "audit:demo-truth-pack": "php tools/audit/tag-demo-truth-pack-audit.php",
    "audit:release-grade-portrait": "php tools/audit/tag-release-grade-portrait-audit.php",
    "audit:assessment-surface": "php tools/audit/tag-assessment-surface-audit.php",
    "hook:install": "php tools/git/tag-install-hooks.php",
    "audit:tooling-entrypoint": "php tools/audit/tag-tooling-entrypoint-audit.php",
    "cmcp:topology-migrate": "@php tools/local/tag-role-first-migrate.php",
    "cmcp:rc-structural-migrate": "@php tools/local/tag-rc-structural-migrate.php",
    "gate": "@php vendor/bin/gating check --target=.",
    "quality": [
      "@cs:check",
      "@phpstan",
      "@test",
      "@gate"
    ]
  },
  "repositories": [
    {
      "type": "path",
      "url": "../Objecting",
      "options": {
        "symlink": true,
        "versions": {
          "objecting/object": "dev-master"
        }
      }
    },
    {
      "type": "path",
      "url": "../Cruding",
      "options": {
        "symlink": true,
        "versions": {
          "cruding/crud": "dev-master"
        }
      }
    },
    {
      "type": "path",
      "url": "../Collectioning",
      "options": {
        "symlink": true,
        "versions": {
          "collectioning/collection": "dev-master"
        }
      }
    },
    {
      "type": "path",
      "url": "../Tabling",
      "options": {
        "symlink": true,
        "versions": {
          "tabling/table": "dev-master"
        }
      }
    },
    {
      "type": "path",
      "url": "../Viewing",
      "options": {
        "symlink": true,
        "versions": {
          "viewing/view": "dev-master"
        }
      }
    },
    {
      "type": "path",
      "url": "../Interfacing",
      "options": {
        "symlink": true,
        "versions": {
          "interfacing/interface": "dev-master"
        }
      }
    },
    {
      "type": "path",
      "url": "../Administering",
      "options": {
        "symlink": true,
        "versions": {
          "administering/administration": "dev-master"
        }
      }
    },
    {
      "type": "path",
      "url": "../Gating",
      "options": {
        "symlink": true,
        "versions": {
          "gating/gate": "dev-master"
        }
      }
    }
  ],
  "config": {
    "allow-plugins": {
      "symfony/runtime": true
    }
  }
}
