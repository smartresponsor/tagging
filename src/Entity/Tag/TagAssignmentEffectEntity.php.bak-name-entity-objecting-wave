declare(strict_types=1);

namespace App\Tagging\Entity\Tag;

use App\Tagging\Repository\Core\Tag\TagAssignmentEffectRepository;
use Doctrine\ORM\Mapping as ORM;

#[ORM\Entity(repositoryClass: TagAssignmentEffectRepository::class)]
#[ORM\Table(nameEntity: 'tag_assignment_effect')]
#[ORM\Index(nameEntity: 'tag_assignment_effect_source_idx', columns: ['tenant', 'source_scope', 'source_id'])]
#[ORM\Index(nameEntity: 'tag_assignment_effect_assigned_idx', columns: ['tenant', 'assigned_type', 'assigned_id'])]
final class TagAssignmentEffectEntity
{
    public function __construct(
        #[ORM\Id]
        #[ORM\Column(type: 'string')]
        private string $tenant,
        #[ORM\Id]
        #[ORM\Column(type: 'string')]
        private string $id,
        #[ORM\Column(nameEntity: 'assigned_type', type: 'string')]
        private string $assignedType,
        #[ORM\Column(nameEntity: 'assigned_id', type: 'string')]
        private string $assignedId,
        #[ORM\Column(type: 'string')]
        private string $key,
        #[ORM\Column(type: 'string')]
        private string $value,
        #[ORM\Column(nameEntity: 'source_scope', type: 'string')]
        private string $sourceScope,
        #[ORM\Column(nameEntity: 'source_id', type: 'string')]
        private string $sourceId,
        #[ORM\Column(nameEntity: 'created_at', type: 'datetime_immutable')]
        private ?\DateTimeImmutable $createdAt = null,
    ) {
        $this->createdAt ??= new \DateTimeImmutable();
    }
}
