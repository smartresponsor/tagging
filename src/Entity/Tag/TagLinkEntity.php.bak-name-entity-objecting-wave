declare(strict_types=1);

namespace App\Tagging\Entity\Tag;

use App\Tagging\Repository\Core\Tag\TagLinkRepository;
use Doctrine\ORM\Mapping as ORM;

#[ORM\Entity(repositoryClass: TagLinkRepository::class)]
#[ORM\Table(nameEntity: 'tag_link')]
#[ORM\Index(nameEntity: 'tag_link_entity_idx', columns: ['tenant', 'entity_type', 'entity_id'])]
#[ORM\Index(nameEntity: 'tag_link_tag_idx', columns: ['tenant', 'tag_id'])]
#[ORM\Index(nameEntity: 'tag_link_created_idx', columns: ['created_at'])]
final class TagLinkEntity
{
    public function __construct(
        #[ORM\Id]
        #[ORM\Column(type: 'string')]
        private string $tenant,
        #[ORM\Id]
        #[ORM\Column(nameEntity: 'entity_type', type: 'string')]
        private string $entityType,
        #[ORM\Id]
        #[ORM\Column(nameEntity: 'entity_id', type: 'string')]
        private string $entityId,
        #[ORM\Id]
        #[ORM\Column(nameEntity: 'tag_id', type: 'string', length: 26)]
        private string $tagId,
        #[ORM\Column(nameEntity: 'created_at', type: 'datetime_immutable')]
        private ?\DateTimeImmutable $createdAt = null,
    ) {
        $this->createdAt ??= new \DateTimeImmutable();
    }

    public static function forProduct(string $tenant, string $productReference, string $tagId): self
    {
        return new self($tenant, 'product', $productReference, $tagId);
    }

    public static function forProject(string $tenant, string $projectReference, string $tagId): self
    {
        return new self($tenant, 'project', $projectReference, $tagId);
    }

    public static function forCategory(string $tenant, string $categoryReference, string $tagId): self
    {
        return new self($tenant, 'category', $categoryReference, $tagId);
    }

    public static function forText(string $tenant, string $textReference, string $tagId): self
    {
        return new self($tenant, 'text', $textReference, $tagId);
    }

    public function tenant(): string
    {
        return $this->tenant;
    }

    public function entityType(): string
    {
        return $this->entityType;
    }

    public function entityId(): string
    {
        return $this->entityId;
    }

    public function tagId(): string
    {
        return $this->tagId;
    }

    public function createdAt(): \DateTimeImmutable
    {
        return $this->createdAt ?? new \DateTimeImmutable();
    }
}
