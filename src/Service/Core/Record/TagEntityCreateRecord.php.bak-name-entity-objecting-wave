<?php

declare(strict_types=1);

namespace App\Tagging\Service\Core\Record;

final readonly class TagEntityCreateRecord
{
    public function __construct(
        public string $id,
        public string $slug,
        public string $nameEntity,
        public string $locale,
        public int $weight,
    ) {}

    /** @return array{id:string,slug:string,nameEntity:string,locale:string,weight:int} */
    public function toArray(): array
    {
        return [
            'id' => $this->id,
            'slug' => $this->slug,
            'nameEntity' => $this->nameEntity,
            'locale' => $this->locale,
            'weight' => $this->weight,
        ];
    }
}
